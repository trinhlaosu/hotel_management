      "script": {
        "type": "text/javascript",
        "exec": [
          "const suffix = Date.now().toString().slice(-8);",
          "pm.collectionVariables.set('suffix', suffix);",
          "pm.collectionVariables.set('demo_username', 'lt_demo_' + suffix);",
          "pm.collectionVariables.set('demo_email', 'lt_demo_' + suffix + '@hotel.vn');",
          "pm.collectionVariables.set('demo_department_name', 'Le tan Demo ' + suffix);",
          "pm.collectionVariables.set('demo_employee_username', 'emp_demo_' + suffix);",
          "pm.collectionVariables.set('demo_employee_email', 'emp_demo_' + suffix + '@hotel.vn');",
          "pm.collectionVariables.set('demo_employee_phone', '09' + suffix);",
          "pm.collectionVariables.set('demo_customer_phone', '08' + suffix);",
          "pm.collectionVariables.set('demo_customer_id_card', '0792' + suffix);",
          "pm.collectionVariables.set('demo_service_name', 'Dich vu demo ' + suffix);"
        ]
      }
    }
