        "description": "Buoc 2: Le tan/quan ly tim danh sach phong trong de dat phong."
      }
    },
    {
      "name": "03 - Them khach hang",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString().slice(-8);",
              "pm.collectionVariables.set('new_customer_phone', '09' + suffix);",
              "pm.collectionVariables.set('new_customer_id_card', '0792' + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Them khach hang thanh cong', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('customer_id', json.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Khach Demo Postman\",\n  \"phone\": \"{{new_customer_phone}}\",\n  \"email\": \"demo.postman@hotel.vn\",\n  \"id_card\": \"{{new_customer_id_card}}\",\n  \"address\": \"TP. Ho Chi Minh\",\n  \"customer_type\": \"regular\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/customers/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "customers",
            ""
          ]
        },
        "description": "Buoc 3: Tao khach hang moi. Request tu dong tao phone/id_card khac nhau de tranh trung du lieu."
      }
    },
