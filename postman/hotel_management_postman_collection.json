{
  "info": {
    "_postman_id": "78f2fcb5-9f24-4c74-84b0-40f5a4ec9d2f",
    "name": "Hotel Management - Main Scenario",
    "description": "Main demo scenario for report: login -> find available rooms -> create customer -> create booking -> confirm -> check-in -> add service -> check-out -> view invoice -> pay invoice -> revenue report -> logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login success', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login",
            ""
          ]
        },
        "description": "Step 1: Manager logs in to use protected APIs."
      }
    },
    {
      "name": "02 - Find available rooms",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/rooms/?status=trong",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rooms",
            ""
          ],
          "query": [
            {
              "key": "status",
              "value": "trong"
            }
          ]
        },
        "description": "Step 2: Find available rooms before creating a booking."
      }
    },
    {
      "name": "03 - Create customer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString().slice(-8);",
              "pm.collectionVariables.set('new_customer_phone', '09' + suffix);",
              "pm.collectionVariables.set('new_customer_id_card', '0792' + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create customer success', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('customer_id', json.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Postman Demo Customer\",\n  \"phone\": \"{{new_customer_phone}}\",\n  \"email\": \"demo.postman@hotel.vn\",\n  \"id_card\": \"{{new_customer_id_card}}\",\n  \"address\": \"TP. Ho Chi Minh\",\n  \"customer_type\": \"regular\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/customers/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "customers",
            ""
          ]
        },
        "description": "Step 3: Create a new customer. The pre-request script generates unique phone and id_card values."
      }
    },
    {
      "name": "04 - Create booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create booking success', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('booking_id', json.data.booking_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": {{customer_id}},\n  \"room_id\": {{room_id}},\n  \"check_in\": \"{{check_in}}\",\n  \"check_out\": \"{{check_out}}\",\n  \"note\": \"Booking demo by Postman\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/bookings/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "bookings",
            ""
          ]
        },
        "description": "Step 4: Create a booking. The system checks room availability and creates an initial invoice."
      }
    },
    {
      "name": "05 - Confirm booking",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/bookings/{{booking_id}}/confirm/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "bookings",
            "{{booking_id}}",
            "confirm",
            ""
          ]
        },
        "description": "Step 5: Confirm the booking and change status to da_xac_nhan."
      }
    },
    {
      "name": "06 - Check-in",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/bookings/{{booking_id}}/check-in/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "bookings",
            "{{booking_id}}",
            "check-in",
            ""
          ]
        },
        "description": "Step 6: Check in the customer. Booking becomes dang_o and room becomes co_khach."
      }
    },
    {
      "name": "07 - Add booking service",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"service_id\": {{service_id}},\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/bookings/{{booking_id}}/services/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "bookings",
            "{{booking_id}}",
            "services",
            ""
          ]
        },
        "description": "Step 7: Add a service used by the customer and update invoice service charge."
      }
    },
    {
      "name": "08 - Check-out",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/bookings/{{booking_id}}/check-out/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "bookings",
            "{{booking_id}}",
            "check-out",
            ""
          ]
        },
        "description": "Step 8: Check out the customer. Booking becomes da_tra_phong and room becomes trong."
      }
    },
    {
      "name": "09 - View invoice by booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get invoice success', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('invoice_id', json.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/bookings/{{booking_id}}/invoice/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "bookings",
            "{{booking_id}}",
            "invoice",
            ""
          ]
        },
        "description": "Step 9: View invoice by booking and save invoice_id for payment."
      }
    },
    {
      "name": "10 - Pay invoice",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payment_method\": \"chuyen_khoan\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/invoices/{{invoice_id}}/pay/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "invoices",
            "{{invoice_id}}",
            "pay",
            ""
          ]
        },
        "description": "Step 10: Pay invoice and change payment_status to da_thanh_toan."
      }
    },
    {
      "name": "11 - Revenue report",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/reports/revenue/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reports",
            "revenue",
            ""
          ]
        },
        "description": "Step 11: Manager views revenue from paid invoices."
      }
    },
    {
      "name": "12 - Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/logout/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "logout",
            ""
          ]
        },
        "description": "Step 12: Logout and clear session."
      }
    }
